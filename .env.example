# =============================================================================
# PROMPTLY — Environment variables template
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. This template is committed for reference.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# DeepSeek (Pro tier only — kept for v2 Path 3-5; not needed for MVP)
DEEPSEEK_API_KEY=

# OpenAI — GPT-4o mini, used by Path 1-2 lessons (V2 format) to comment on
# the user's answer to open-ended questions. Required from V2 onward.
# Lesson-level system prompts live inside each lesson JSON
# (open_question.system_prompt), so this var only carries the API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_LIFETIME=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@learnpromptly.app

# Site
NEXT_PUBLIC_SITE_URL=
