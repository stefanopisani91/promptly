# =============================================================================
# PROMPTLY — Environment variables template
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. This template is committed for reference.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
# Verified domain on Resend: send.learnpromptly.app (DKIM/SPF/DMARC configured May 16, 2026)
RESEND_FROM_EMAIL=Promptly <welcome@send.learnpromptly.app>

# DeepSeek (Pro tier only — kept for v2 Path 3-5; not needed for MVP)
DEEPSEEK_API_KEY=

# OpenAI — GPT-4o mini, used by /api/comment-answer (V2 lesson commentary)
# and /api/landing-evaluate (public Lucia demo). NOT used by Spark's free
# chat — that runs on Anthropic (see below).
# Lesson-level system prompts live inside each lesson JSON
# (open_question.system_prompt), so this var only carries the API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — Claude Haiku 4.5, used by /api/spark-chat (Spark's free chat).
# ANTHROPIC_MODEL must be the full canonical id with date suffix; do NOT use
# the bare alias "claude-haiku-4-5". The same string is the hardcoded
# fallback in lib/ai/anthropic.ts. See Promptly_Spark_Master_Configuration.md
# §6 (Sessione 1) for the full setup, including the spending-limit cap to
# set on console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=220

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_LIFETIME=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
# api_host è hardcoded a /ingest in lib/analytics/posthog.ts: reverse-proxy
# tramite rewrites in next.config.mjs per bypassare filtri DNS (Fortinet,
# WiFi enterprise). Non serve env var.

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@learnpromptly.app

# Site
NEXT_PUBLIC_SITE_URL=
