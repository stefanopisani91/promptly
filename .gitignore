npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal guides (private notes for the developer, never on git)
GUIDA-*.md
NOTE-*.md

# spark coherence test outputs (raw model responses + scratch files)
scripts/_spark-test-output.json
scripts/_*.json

# MCP config workspace-level (può contenere credenziali/config locali)
.vscode/mcp.json
**/.vscode/mcp.json
.mcp.json

# Local dev-only QA login endpoint — never on git per security review
app/api/qa-login/

# Playwright MCP debug output (snapshot + console logs)
.playwright-mcp/

# Supabase CLI scratch/cache files
supabase/.temp/

# Claude Code per-user local settings (permissions etc.) — never on git.
# `.claude/agents/*.md` and a shared `.claude/settings.json` ARE checked in;
# only the .local.json variant stays local to each developer.
.claude/settings.local.json
